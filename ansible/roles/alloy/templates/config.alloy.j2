// Géré par Ansible - configuration Grafana Alloy ({{ env_name }})

logging {
  level = "info"
}

// ---------------------------------------------------------------
// LOGS des conteneurs Docker -> Loki
// ---------------------------------------------------------------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  labels        = { env = "{{ env_name }}", host = "{{ inventory_hostname }}", source = "docker" }
  forward_to    = [loki.write.monitoring.receiver]
}

// ---------------------------------------------------------------
// LOGS système (syslog, authentification SSH) -> Loki
// ---------------------------------------------------------------
local.file_match "system" {
  path_targets = [
    { "__path__" = "/var/log/syslog", "job" = "syslog" },
    { "__path__" = "/var/log/auth.log", "job" = "auth" },
  ]
}

loki.source.file "system" {
  targets    = local.file_match.system.targets
  forward_to = [loki.process.system.receiver]
}

loki.process "system" {
  stage.static_labels {
    values = { env = "{{ env_name }}", host = "{{ inventory_hostname }}", source = "system" }
  }
  forward_to = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
  endpoint {
    url = "{{ loki_push_url }}"

    basic_auth {
      username = "{{ ingest_user }}"
      password = "{{ ingest_password }}"
    }
  }
}

// ---------------------------------------------------------------
// MÉTRIQUES de la machine (équivalent node_exporter) -> Prometheus
// ---------------------------------------------------------------
prometheus.exporter.unix "node" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

prometheus.scrape "node" {
  targets         = prometheus.exporter.unix.node.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}

prometheus.remote_write "monitoring" {
  external_labels = { env = "{{ env_name }}", host = "{{ inventory_hostname }}" }

  endpoint {
    url = "{{ metrics_push_url }}"

    basic_auth {
      username = "{{ ingest_user }}"
      password = "{{ ingest_password }}"
    }
  }
}
